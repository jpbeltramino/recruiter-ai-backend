{
  "Anthropic": {
        "ApiKey": "YOUR_ANTHROPIC_API_KEY_HERE"
  },
  "Auth": {
    "ValidTokens": []
  },
  "RateLimit": {
    "DailyLimit": 50
  },
    "FileLimits": {
    "MaxPdfSizeMb": 5,
    "MaxCandidatesPerRequest": 20,
    "MaxExtractedTextChars": 30000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

{
  "Anthropic": {
        "ApiKey": "YOUR_ANTHROPIC_API_KEY_HERE"
  },
  "Auth": {
    "ValidTokens": []
  },
  "RateLimit": {
    "DailyLimit": 50
  },
    "FileLimits": {
    "MaxPdfSizeMb": 5,
    "MaxCandidatesPerRequest": 20,
    "MaxExtractedTextChars": 30000
  },
  "Cors": {
  "AllowedOrigins": [
    "http://localhost:4200"
  ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Parallelism": {
  "BatchSize": 5,
  "DelayBetweenBatchesMs": 1000
},
"Sentry": {
  "Dsn": "",
  "TracesSampleRate": 0.2,
  "Environment": "development"
}

}
